# Copy to .data/compute.env, fill it privately, and upload with supabase secrets set.
# Use docs/setup.md for the setup -> signed webhook test -> live deployment sequence.
APP_MODE=setup
PUBLIC_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/compute/v1/threadsong
RUN_WORKER=true

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
LYRIA_MODEL=lyria-3.5
SONG_DURATION_SECONDS=30
GENERATION_TIMEOUT_SECONDS=300

ANDO_API_KEY=
ANDO_WORKSPACE_ID=
ANDO_AGENT_MEMBER_ID=
# Fill this after creating the outbound webhook; it is separate from ANDO_API_KEY.
ANDO_WEBHOOK_SIGNING_SECRET=
ANDO_MENTION_TOKEN=@Songbot
ANDO_ALLOWED_CONVERSATIONS=

WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=420
MAX_JOB_ATTEMPTS=4
MAX_THREAD_MESSAGES=150
MAX_CONTEXT_CHARS=30000

# Do not copy local DATABASE_URL or PORT into this file.
# The verified Compute runtime injects SUPABASE_DB_URL, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, and PORT. Keep the default private songs bucket.
# The CLI reserves SUPABASE_ names; do not upload them as custom secrets.
