# Copy to .env. Demo mode needs no keys and never calls external services.
APP_MODE=demo
# Hosted containers default to setup: signed webhook.test only, no song jobs.
# Switch runtime APP_MODE to live after the database and all credentials are ready.
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
DATABASE_URL=sqlite+aiosqlite:///.data/threadsong.db
LOCAL_DATA_DIR=.data
RUN_WORKER=true

# Live mode: APP_MODE=live. Use Supabase's direct or session-pooler Postgres URL.
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?ssl=require
# Apply the included Supabase migration before running live mode.
SUPABASE_URL=
# Server-side sb_secret_... key (preferred) or legacy service_role JWT.
# Variable name is retained for compatibility; never use a publishable/anon key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=songs

# One dedicated Ando agent, added to the intended conversations.
ANDO_API_KEY=
ANDO_WORKSPACE_ID=
ANDO_AGENT_MEMBER_ID=
ANDO_WEBHOOK_SIGNING_SECRET=
# Literal text appearing in the API's markdown for a mention of your agent.
# @Songbot and <@ANDO_AGENT_MEMBER_ID> are recognized; override for other markup.
ANDO_MENTION_TOKEN=@Songbot
# Optional comma-separated allowlist. Empty means the agent's accessible conversations.
ANDO_ALLOWED_CONVERSATIONS=

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
LYRIA_MODEL=lyria-3.5
GENERATION_TIMEOUT_SECONDS=300
# Prompt target only; Lyria may generate longer. Pricing is per song, not per second.
SONG_DURATION_SECONDS=30

# Compute runs the API and worker together; no Edge Function, Cron or external queue required.
# Worker leases exceed the music HTTP timeout. No automatic retry of uncertain generations.
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=420
MAX_JOB_ATTEMPTS=4
MAX_THREAD_MESSAGES=150
MAX_CONTEXT_CHARS=30000
